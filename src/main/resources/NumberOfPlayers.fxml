<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.client.scene.NumberOfPlayersController">
    <ImageView fitHeight="406.0" fitWidth="607.0" layoutY="-3.0">
        <Image url="@Images/blurred_Welcome.jpg" />
    </ImageView>
    <ProgressIndicator fx:id="progress" layoutX="268.0" layoutY="330.0" prefHeight="80.0" prefWidth="80.0" visible="false">
      <effect>
         <Glow />
      </effect>
   </ProgressIndicator>
   <Text fx:id="text" fill="#8c3300" layoutX="186.0" layoutY="302.0" stroke="#722800" strokeType="OUTSIDE" strokeWidth="0.4" text="Waiting for other players to connect" textAlignment="CENTER" visible="false">
      <font>
         <Font name="PT Serif Caption" size="13.0" />
      </font></Text>

    <Button fx:id="threePlayers" alignment="CENTER" contentDisplay="CENTER" graphicTextGap="0.0" layoutX="278.0" layoutY="196.0" prefHeight="46.0" prefWidth="49.0" style="-fx-background-color: transparent; -fx-text-fill: #7c4732;" styleClass="glowing-button" text="3" textAlignment="CENTER" textOverrun="CLIP">
        <graphic>
            <ImageView fitHeight="72.0" fitWidth="57.0">
                <Image url="@Images/buttons_disegno.png" />
            </ImageView>
        </graphic>
        <font>
            <Font name="Arial Bold" size="18.0" />
        </font>
    </Button>

    <Button fx:id="fourPlayers" alignment="CENTER" contentDisplay="CENTER" graphicTextGap="0.0" layoutX="387.0" layoutY="196.0" prefHeight="46.0" prefWidth="48.0" style="-fx-background-color: transparent; -fx-text-fill: #7c4732;" styleClass="glowing-button" text="4" textAlignment="CENTER" textOverrun="CLIP">
        <graphic>
            <ImageView fitHeight="72.0" fitWidth="57.0">
                <Image url="@Images/buttons_disegno.png" />
            </ImageView>
        </graphic>
        <font>
            <Font name="Arial Bold" size="18.0" />
        </font>
    </Button>

    <Button fx:id="twoPlayers" alignment="CENTER" contentDisplay="CENTER" graphicTextGap="0.0" layoutX="172.0" layoutY="196.0" prefHeight="46.0" prefWidth="49.0" style="-fx-background-color: transparent; -fx-text-fill: #7c4732;" styleClass="glowing-button" text="2" textAlignment="CENTER" textOverrun="CLIP">
        <graphic>
            <ImageView fitHeight="72.0" fitWidth="57.0">
                <Image url="@Images/buttons_disegno.png" />
            </ImageView>
        </graphic>
        <font>
            <Font name="Arial Bold" size="18.0" />
        </font>
    </Button>
   <ImageView fitHeight="46.0" fitWidth="345.0" layoutX="141.0" layoutY="146.0">
      <image>
         <Image url="@Images/numberOfPlayers.png" />
      </image>
   </ImageView>
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
</AnchorPane>
