   <Button fx:id="fourPlayers" alignment="CENTER" layoutX="372.0" layoutY="221.0" mnemonicParsing="false" prefHeight="46.0" prefWidth="48.0" style="-fx-background-color: #f2dfa7; -fx-background-radius: 7px; -fx-border-color: #b04800; -fx-border-radius: 7px; -fx-border-width: 1.8;" text="4" />
   <Button fx:id="twoPlayers" alignment="CENTER" layoutX="180.0" layoutY="221.0" mnemonicParsing="false" prefHeight="46.0" prefWidth="48.0" style="-fx-background-color: #f2dfa7; -fx-background-radius: 7px; -fx-border-color: #b04800; -fx-border-radius: 7px; -fx-border-width: 1.8;" text="2" />

