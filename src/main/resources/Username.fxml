<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.client.NicknameController">
   <children>
      <ImageView fitHeight="499.0" fitWidth="1359.0" layoutX="-182.0" layoutY="-5.0">
         <image>
            <Image url="@Username.png" />
         </image>
      </ImageView>
      <TextField fx:id="nicknameText" alignment="CENTER" layoutX="252.0" layoutY="294.0" minWidth="9.0" onKeyPressed="#login" pickOnBounds="false" prefHeight="41.0" prefWidth="179.0" promptText="type nick here">
         <font>
            <Font name="System Font" size="18.0" />
         </font>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="5.0" />
         </padding>
      </TextField>
      <Text fill="#b9a300" layoutX="208.0" layoutY="283.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Insert Your Nickname:" textAlignment="CENTER" underline="true">
         <font>
            <Font name="Zapfino" size="20.0" />
         </font>
      </Text>
      <Text fx:id="errorNick" fill="RED" layoutX="212.0" layoutY="325.0" strokeType="OUTSIDE" strokeWidth="0.0" text="nickname not available" textAlignment="CENTER" visible="false" wrappingWidth="208.64202880859375">
         <font>
            <Font name="Negotiate Free" size="13.0" />
         </font>
      </Text>
      <Text fx:id="waitingOther" fill="#2a1b75" layoutX="192.0" layoutY="350.0" strokeType="OUTSIDE" strokeWidth="0.0" text="WAIT: Someone is choosing his nickname..." textAlignment="CENTER" visible="false">
         <font>
            <Font name="Negotiate Free" size="14.0" />
         </font>
      </Text>
   </children>
</AnchorPane>
