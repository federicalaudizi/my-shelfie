<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>


<?import java.net.URL?>
<AnchorPane prefHeight="400.0" prefWidth="608.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.client.scene.GameOptionsController">
   <ImageView fitHeight="406.0" fitWidth="609.0">
      <Image url="@Images/blurred_Welcome.jpg" />
   </ImageView>
   <ImageView fitHeight="54.0" fitWidth="339.0" layoutX="134.0" layoutY="149.0">
      <Image url="@Images/whatDoyouWant.png" />
   </ImageView>
   <StackPane  layoutX="24.0" layoutY="202.0">
      <Button styleClass="glowing-button" onMouseClicked="#handleJoin">
         <graphic>
            <ImageView fitHeight="44.0" fitWidth="164.0">
               <Image url="@Images/buttons_disegno.png"/>
            </ImageView>
         </graphic>
      </Button>
   </StackPane>
   <Text fill="#7c4732" layoutX="49.0" layoutY="226.0" stroke="#7c4732" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="0.4" text="Join an existing game" onMouseClicked="#handleJoin">
      <font>
         <Font size="12.0" />
      </font>
   </Text>
   <StackPane  layoutX="208.0" layoutY="203.0">
      <Button styleClass="glowing-button" onMouseClicked="#handleCreate">
         <graphic>
            <ImageView fitHeight="44.0" fitWidth="155.0">
               <Image url="@Images/buttons_disegno.png"/>
            </ImageView>
         </graphic>
      </Button>
   </StackPane>
   <Text fill="#7c4732" layoutX="234.0" layoutY="226.0" stroke="#7c4732" strokeLineJoin="ROUND" strokeWidth="0.4" text="Create a new game" wrappingWidth="105.04034423828125" onMouseClicked="#handleCreate">
      <font>
         <Font size="12.0" />
      </font>
   </Text>
   <StackPane  layoutX="377.0" layoutY="203.0">
      <Button styleClass="glowing-button" onMouseClicked="#handleReconnect">
         <graphic>
            <ImageView fitHeight="44.0" fitWidth="232.0">
               <Image url="@Images/buttons_disegno.png"/>
            </ImageView>
         </graphic>
      </Button>
   </StackPane>
   <Text fill="#7c4732" layoutX="410.0" layoutY="226.0" stroke="#7c4732" strokeLineJoin="ROUND" strokeMiterLimit="0.0" strokeWidth="0.4" text="Reconnect to an ongoing game" onMouseClicked="#handleReconnect">
      <font>
         <Font size="12.0" />
      </font>
   </Text>
   <stylesheets>
      <URL value="@styles.css" />
